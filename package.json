{
  "name": "dsh-antigravity",
  "version": "0.4.16",
  "description": "DSH 插件：Google Antigravity 模型提供商适配器 —— 原生模型接入，提供多账号管理与用量统计面板",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-antigravity": "./lib/bin.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && chmod +x lib/bin.js",
    "prepack": "npm run build",
    "test": "npm run build && node test/test.js && node test/usage.js",
    "test:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/cosmokit": "^1.8.4",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1"
  },
  "keywords": [
    "dsh",
    "antigravity",
    "gemini",
    "claude",
    "llm",
    "cordis"
  ],
  "license": "MIT"
}
